    "threads": 4,
    "preprocessing": "fold-local 1st/99th percentile winsorization and median imputation",
    "lag_specifications_quarters": [0, 1, 2]
  },
  "capital_screen": {
    "display_name": "Capital Screen",
    "score": "-equity_to_assets",
