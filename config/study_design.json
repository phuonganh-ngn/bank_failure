{
  "study": "Multi-horizon bank-failure early warning with capital-ratio benchmarking",
  "data": {
    "panel": "data/model_panel.parquet",
    "variable_dictionary": "data/variable_dictionary.csv",
    "economic_logit_predictors": "config/economic_logit_predictors.csv",
    "eligible_failure_paths_file": "data/eligible_failure_paths.csv",
    "predictor_start": "2001Q1",
    "predictor_end": "2024Q3",
    "institutions": 11046,
    "institution_quarters": 671414,
    "linked_failures": 574,
    "eligible_failure_path_count": 515
  },
  "outcomes": {
    "horizons_quarters": [1, 2, 4, 8],
    "label_prefix": "fail_",
    "strict_training_maturity": "training_origin_quarter + horizon < test_start_quarter"
  },
  "out_of_time_folds": [
    {"name": "gfc", "start": "2007Q1", "end": "2009Q4"},
    {"name": "post_gfc", "start": "2010Q1", "end": "2018Q4"},
    {"name": "covid_modern", "start": "2019Q1", "end": "2024Q3"}
