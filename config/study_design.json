    "model_fitted": false
  },
  "operational_evaluation": {
    "horizon_quarters": 8,
    "quarterly_candidate_capacity_grid": {"start": 0.005, "stop_inclusive": 0.15, "step": 0.0025},
    "candidate_quota_rounding": "ceil(capacity * eligible_active_institutions_in_quarter)",
    "persistence": "same institution in two consecutive calendar quarters",
    "confirmation": "second consecutive quarter",
    "fixed_workload_targets": [50, 100, 175, 250],
    "fixed_workload_tolerance_alerts": 2,
    "exposure_weight_date": "T-4",
    "bootstrap_seed": 20261010,
    "bootstrap_replicates": 2000
