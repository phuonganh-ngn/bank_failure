  "targeted_ablation": {
    "name": "STRUCTURAL_PLUS_CAPITAL",
    "features": "STRUCTURAL plus equity_to_assets only",
    "horizon_quarters": 8,
    "retuning": false
  },
  "four_quarter_seed_sensitivity": {
    "seed_indices": [0, 1, 2, 3, 4],
    "information_sets": ["EARLY", "FULL"],
    "purpose": "Assess whether the pooled 4Q AP gap persists across the five saved Random Forest seed specifications"
  },
  "primary_random_forest": {
    "class_weight": "balanced_subsample",
    "n_estimators": 60,
    "max_samples": 0.2,
